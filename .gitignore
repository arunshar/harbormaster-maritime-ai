# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- uv and virtual environments ----
.venv/
venv/
env/
ENV/
.python-version

# ---- Environment files and secrets ----
.env
.env.*
!.env.example
secrets.*
credentials.*
*.pem
*.key
.envrc
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
kubeconfig
