   "text": "PostgreSQL holds vessels, watchlist, and sanctions_flags.\nAuthorized registry writers own these rows.\nCDC selects these tables and excludes hitl_queue.",
   "fontSize": 16,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
