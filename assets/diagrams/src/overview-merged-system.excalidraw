   "text": "The reference is loaded once, reused per request.\nThis lane-artifact serving bridge remains assumed integration.",
   "fontSize": 16,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The reference is loaded once, reused per request.\nThis lane-artifact serving bridge remains assumed integration.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "bdL2KVqAv5Kp_1PjGkvap",
   "type": "text",
   "x": 860,
   "y": 1530,
   "width": 528.9792000000002,
   "height": 80,
   "angle": 0,
   "strokeColor": "#666666",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aJ",
   "roundness": null,
   "seed": 1824210013,
   "version": 3,
   "versionNonce": 2033952817,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789171502989,
   "created": 1789171502988,
   "link": null,
   "locked": false,
   "text": "The archive contains raw JSON. Backfill requires Parquet.\nThe preparation bridge remains assumed integration.\nRDP precedes HDBSCAN and edge counting.\nThe local driver batch must fit memory. Extra workers do not fix this.",
   "fontSize": 16,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The archive contains raw JSON. Backfill requires Parquet.\nThe preparation bridge remains assumed integration.\nRDP precedes HDBSCAN and edge counting.\nThe local driver batch must fit memory. Extra workers do not fix this.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
