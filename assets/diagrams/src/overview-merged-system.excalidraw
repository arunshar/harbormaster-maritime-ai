   "link": null,
   "locked": false,
   "text": "Initial snapshot reads also initialize the projection.\nThe snapshot guard protects newer streamed state.\nLSN guards reject stale writes. Sinks flush before Kafka progress.\nCache invalidations and audit records can repeat.",
   "fontSize": 16,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Initial snapshot reads also initialize the projection.\nThe snapshot guard protects newer streamed state.\nLSN guards reject stale writes. Sinks flush before Kafka progress.\nCache invalidations and audit records can repeat.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
