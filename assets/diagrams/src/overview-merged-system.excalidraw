   "created": 1789114324778,
   "link": null,
   "locked": false,
   "text": "Functional requirements\n\nThe system assesses vessel reports.\nThe analyst reads and labels review cases.\nRegistry edits reach later lookups.\nHistorical tracks supply lane context.\nModel jobs return checked results.",
   "fontSize": 23,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "0KIGSZlYJ5IF1GtZy2weL",
   "originalText": "Functional requirements\n\nThe system assesses vessel reports.\nThe analyst reads and labels review cases.\nRegistry edits reach later lookups.\nHistorical tracks supply lane context.\nModel jobs return checked results.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "sE82STFN325MhQJ-wQB-L",
   "type": "rectangle",
