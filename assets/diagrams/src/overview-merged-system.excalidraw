   "text": "The five workflows have separate triggers, so opening the dashboard does not start all five.",
   "fontSize": 23,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The five workflows have separate triggers, so opening the dashboard does not start all five.",
