   "updated": 1789253501552,
   "created": 1789114324778,
   "link": null,
   "locked": false,
   "text": "Non-functional requirements\n\nInvalid input stays visible.\nStored decisions remain durable.\nCopies reveal processing delay.\nReplays protect newer state.\nWork stays within agreed resource limits.",
   "fontSize": 23,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "sE82STFN325MhQJ-wQB-L",
   "originalText": "Non-functional requirements\n\nInvalid input stays visible.\nStored decisions remain durable.\nCopies reveal processing delay.\nReplays protect newer state.\nWork stays within agreed resource limits.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
