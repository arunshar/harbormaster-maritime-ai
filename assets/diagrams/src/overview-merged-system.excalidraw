   "link": null,
   "locked": false,
   "text": "The cheap gate selects work. It does not certify excluded reports as safe.\nThe scorer computes corridor distance against the loaded reference.\nNo Feature Store read is wired into the current scorer.",
   "fontSize": 16,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The cheap gate selects work. It does not certify excluded reports as safe.\nThe scorer computes corridor distance against the loaded reference.\nNo Feature Store read is wired into the current scorer.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
