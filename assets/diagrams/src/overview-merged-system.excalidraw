   "boundElements": [],
   "updated": 1789171503208,
   "created": 1789171502988,
   "link": null,
   "locked": false,
   "text": "This snapshot does not contain the Pi-DPM scorer code.\nThe stand-in keeps a separate identity from any real model.\nCandidate V3 is not deployed.",
   "fontSize": 16,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "This snapshot does not contain the Pi-DPM scorer code.\nThe stand-in keeps a separate identity from any real model.\nCandidate V3 is not deployed.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "JiuGqlCMMwZ4fNE0RZuJc",
   "type": "text",
   "x": 2630,
   "y": 2100,
   "width": 424.7464,
   "height": 40,
   "angle": 0,
   "strokeColor": "#666666",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aN",
   "roundness": null,
   "seed": 1666418973,
   "version": 4,
   "versionNonce": 1225620529,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789171502989,
   "created": 1789171502988,
   "link": null,
   "locked": false,
   "text": "The Model Endpoint writes output objects to S3.\nThe planned collector checks request and model identity.",
   "fontSize": 16,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The Model Endpoint writes output objects to S3.\nThe planned collector checks request and model identity.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
