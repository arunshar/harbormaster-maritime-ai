   "locked": false,
   "text": "PostgreSQL holds hitl_queue. CDC excludes this table.\nThe Scoring Service writes cases when review rules apply.\nThe Review Service writes the reviewer and label.",
   "fontSize": 16,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "PostgreSQL holds hitl_queue. CDC excludes this table.\nThe Scoring Service writes cases when review rules apply.\nThe Review Service writes the reviewer and label.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "hDQ3yAsY3Ax7XKDiIPd_2",
   "type": "text",
   "x": 820,
   "y": 305,
   "width": 511.98080000000033,
   "height": 80,
   "angle": 0,
   "strokeColor": "#666666",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "a2",
   "roundness": null,
   "seed": 1433274707,
   "version": 4,
   "versionNonce": 1211354207,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789171502989,
   "created": 1789171502987,
   "link": null,
   "locked": false,
   "text": "Feedback preserves the assessment score.\nqueue_position counts remaining unlabeled cases.\nA missing trace_id returns 404 harbormaster.hitl_trace_not_found.\nFeedback triggers no registry write, rescore, or model update.\nserving/app/errors.py defines this HTTP status.",
   "fontSize": 16,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Feedback preserves the assessment score.\nqueue_position counts remaining unlabeled cases.\nA missing trace_id returns 404 harbormaster.hitl_trace_not_found.\nFeedback triggers no registry write, rescore, or model update.\nserving/app/errors.py defines this HTTP status.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
