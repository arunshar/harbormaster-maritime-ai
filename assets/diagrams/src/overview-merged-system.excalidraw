   "isDeleted": false,
   "boundElements": [],
   "updated": 1789256609402,
   "created": 1789171502988,
   "link": null,
   "locked": false,
   "text": "The operator controls model release separately from requests.\nA real release must bind code, data, environment, evaluation, and checkpoint.\nThe release must pin the runtime, normalization, and operating threshold.",
   "fontSize": 16,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The operator controls model release separately from requests.\nA real release must bind code, data, environment, evaluation, and checkpoint.\nThe release must pin the runtime, normalization, and operating threshold.",
   "autoResize": false,
   "lineHeight": 1.25,
   "labelPosition": null
  },
  {
   "id": "ZFFDGWVFeQcD4FKI_ZPeu",
   "type": "text",
   "x": 820,
   "y": 2350,
   "width": 726.6934634146346,
   "height": 40,
   "angle": 0,
   "strokeColor": "#666666",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "index": "aQ",
   "roundness": null,
   "seed": 404620499,
   "version": 3,
   "versionNonce": 1359949597,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1789171502989,
   "created": 1789171502988,
   "link": null,
   "locked": false,
   "text": "An acknowledgement is not a completed result.\nIn the design, a dispatch timeout stays unresolved and permits no automatic retry or rerouting.",
   "fontSize": 16,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "An acknowledgement is not a completed result.\nIn the design, a dispatch timeout stays unresolved and permits no automatic retry or rerouting.",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
