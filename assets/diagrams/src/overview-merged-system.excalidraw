   "text": "Core entities\n\nVessel | Position Fix | Assessment\nReview Case | Review Label | Registry Row\nChange Event | Lane Reference\nPrepared Input | Job Receipt | Model Release",
   "fontSize": 23,
   "baseFontSize": null,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "EnFTHeZkoTq-AfpDaHaUm",
   "originalText": "Core entities\n\nVessel | Position Fix | Assessment\nReview Case | Review Label | Registry Row\nChange Event | Lane Reference\nPrepared Input | Job Receipt | Model Release",
   "autoResize": true,
   "lineHeight": 1.25,
   "labelPosition": null
  },
